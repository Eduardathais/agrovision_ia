OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=30m
AGENT_EVENT_LIMIT=12
MAX_HISTORY_MESSAGES=8

# Fonte de vídeo:
#   0                → webcam local
#   /caminho/video.mp4  → arquivo de vídeo
#   rtsp://...       → stream RTSP
#   https://...m3u8  → stream HLS (ex: Caltrans)
#   https://...jpg   → snapshot JPEG com polling (ex: CETSP)
#
# Câmera pública Caltrans (HLS stream):
# CAMERA_SOURCE=https://wzmedia.dot.ca.gov/D11/C214_SB_5_at_Via_De_San_Ysidro.stream/playlist.m3u8
#
# Câmera pública CETSP São Paulo (snapshot JPEG):
CAMERA_SOURCE=https://cameras.cetsp.com.br/Cams/200/4.jpg
CAMERA_RECONNECT_SECONDS=5

# Coordenadas geográficas da fazenda (usadas pelo scraping de clima)
LATITUDE=-23.5
LONGITUDE=-46.6

# Tempo de cache para dados externos (segundos); padrão = 1 hora
SCRAPING_CACHE_TTL_SECONDS=3600
